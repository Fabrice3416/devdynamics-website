# Environment files
.env
.env.local
*.env
.env.hostinger.example
!.env.example
!api/.env.example

# Logs
*.log
backend/logs/

# Uploads
backend/uploads/*
!backend/uploads/.gitkeep

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Dependencies
backend/vendor/
api/vendor/
node_modules/

# Backups
*.backup
*.sql

# Les schemas versionnes ne sont pas des exports : la regle *.sql ci-dessus
# vise les dumps de base, pas les migrations qui doivent suivre le code.
!api/sql/*.sql
!bousol/database/*.sql

# Build
*.zip

# Dev scripts
backend/create-*.php
backend/check-*.php
backend/test-*.php
backend/*.ps1
backend/*.bat

# API maintenance scripts (keep in repo but shouldn't be in production)
api/create-*.php
api/init-*.php
api/check-*.php
api/reset-*.php
api/export-*.php
api/clear-*.php

#claude
*.claude


#dev
.dev

# Bousol (pilotage KesKle)
# Le schema de la base est du code source, pas une sauvegarde : la regle *.sql
# ci-dessus l'excluait silencieusement, et le depot livrait un outil sans sa base.
!/bousol/database/*.sql
/bousol/includes/config.php
/bousol/storage/*
!/bousol/storage/*/
/bousol/storage/*/*
!/bousol/storage/**/.gitkeep
!/bousol/storage/.htaccess
/bousol/lib/mpdf/*
!/bousol/lib/.gitkeep

# Gabarits PAIESC de reference (hors depot)
/bousol_documents/
