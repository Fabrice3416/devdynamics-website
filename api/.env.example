# Configuration de l'API DevDynamics
#
# Ce fichier est un modele. Sur le serveur, copie-le en api/.env et remplis
# les valeurs. api/.env n'est JAMAIS commite : il doit etre cree a la main
# sur Hostinger, et il survit aux deploiements.
#
# Sans api/.env, chaque fichier de routes echoue des le chargement sur
# Database::getInstance() et TOUTE l'API renvoie 500 avec un corps vide.

# --- Base de donnees (hPanel > Bases de donnees) ---
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# --- Jetons d'authentification ---
# A NE PAS LAISSER VIDE : sans cette valeur, JWT.php retombe sur la chaine
# 'your_jwt_secret_key_here' ecrite en clair dans le depot public, et
# n'importe qui pourrait forger un jeton d'administrateur.
# Generer avec : openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY=604800

# --- Environnement ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://dev-dynamics.org

# --- Courriel (facultatif) ---
ACP_NOTIFY_EMAIL=contact@dev-dynamics.org
SMTP_FROM_NAME=DevDynamics
