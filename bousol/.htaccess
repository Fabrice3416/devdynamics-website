# Bousol - configuration Apache

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Fichiers sensibles
<FilesMatch "^(\.env|config\.php|.*\.sql|.*\.md|.*\.json)$">
    Require all denied
</FilesMatch>

# Aucun acces direct au code interne, aux libs, a la base et au stockage
RedirectMatch 403 ^/bousol/(includes|lib|database|storage|tests|gabarits)(/.*)?$

Options -Indexes

ErrorDocument 403 /bousol/errors/403.html
ErrorDocument 404 /bousol/errors/404.html

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=()"
</IfModule>
