# Portail DEVDYNAMICS / ACP - configuration Apache

# Forcer HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Cacher les fichiers sensibles
<FilesMatch "^(\.env|config\.php|.*\.sql|.*\.md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloquer l'acces direct aux includes, models, services, controllers, lib, database
RedirectMatch 403 ^/portail/(includes|models|services|controllers|lib|database)(/.*)?$

# Empecher le listing des dossiers
Options -Indexes

# Page d'erreur 403/404 (a creer plus tard)
ErrorDocument 403 /portail/errors/403.html
ErrorDocument 404 /portail/errors/404.html

# Cache statique
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
</IfModule>

# Securite : entetes HTTP
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
